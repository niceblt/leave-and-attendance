{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^start:dev"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "start:dev": {
    "dependsOn": ["^start:dev"],
      "persistent": true,
      "cache": false
    }
  }
}